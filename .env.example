# ================================================================
# TradeShark - Railway & Cloud Environment Configuration
# ================================================================

# ---------- Database (Pick Railway MySQL or Postgres) ----------
# Option A: Railway MySQL (RECOMMENDED if you use Railway MySQL service)
# Railway provides MYSQL_URL or individual variables automatically when you attach MySQL:
# MYSQL_URL=${{MySQL.MYSQL_URL}}
# Or you can provide standard DATABASE_URL pointing to mysql:// or postgres://:
# DATABASE_URL=mysql://root:password@host:3306/railway

# Option B: Railway Postgres (Alternative)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Option C: Git file backup (Continuous persistence)
# The system automatically syncs database state to db-backup.json in the repository root.
# On fresh Railway deployments, it auto-restores from this file if database is empty!
GIT_BACKUP_PATH=./db-backup.json

# ---------- Core Security & Authentication ----------
JWT_SECRET=change-me-to-a-long-random-string-64chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-pass
ADMIN_EMAIL=admin@yourdomain.com
APP_URL=https://yourdomain.up.railway.app

# ---------- Email Service Configuration ----------
# Option A: Direct SMTP (Gmail, Titan, PrivateEmail, Namecheap, Zoho, etc.)
# Can also be configured directly in Admin Console -> Email Delivery -> Configure SMTP!
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=support@yourdomain.com
MAIL_FROM_NAME=TradeShark
SUPPORT_EMAIL=support@yourdomain.com
MAIL_REPLY_TO=support@yourdomain.com

# Option B: Resend API Key (Optional auto-domain verification)
RESEND_API_KEY=

# Option C: Brevo API Key (Optional backup)
BREVO_API_KEY=

# ---------- Client Security & Login OTP ----------
LOGIN_OTP=true                  # Email 6-digit OTP code on client login
OTP_TTL_MINUTES=10
MAX_FAILED_LOGINS=5             # Wrong passwords before account is locked
LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_LOGIN_ALERTS=false

# ---------- Platform Branding & Customization ----------
APP_NAME=TradeShark
APP_TAGLINE=Trade and invest in stocks, crypto, ETFs and more
COMPANY_LEGAL_NAME=TradeShark Ltd
COMPANY_ADDRESS=71-75 Shelton Street, Covent Garden, London, WC2H 9JQ, UK
COMPANY_NUMBER=14298190
GEMINI_API_KEY=
LIVE_CHAT_SCRIPT_URL=
